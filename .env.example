# Copy to .env.local for local development against a real backend.
# Leave VITE_API_URL empty to run the built-in demo (sample data, simulated PayPal + push).

# Apps Script web app URL (Deploy > Manage deployments > Web app URL, ends in /exec)
VITE_API_URL=

# Firebase web app config (Firebase console > Project settings > Your apps > Web app), as one-line JSON
VITE_FIREBASE_CONFIG=
# Firebase console > Project settings > Cloud Messaging > Web Push certificates > Key pair (public key)
VITE_FIREBASE_VAPID_KEY=
