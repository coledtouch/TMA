{
  "name": "tma-boosters",
  "private": true,
  "version": "0.1.0",
  "description": "Timberlane Music Association family app: activity funds, trips, payments and notifications (PWA).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "build:gas": "node scripts/build-gas.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.gas.json --noEmit && tsc -p tsconfig.gas-test.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p workers/push/tsconfig.json --noEmit && tsc -p workers/app/tsconfig.json --noEmit",
    "test": "vitest run && vitest run --config workers/push/vitest.config.ts && vitest run --config workers/app/vitest.config.ts",
    "test:worker": "vitest run --config workers/push/vitest.config.ts",
    "test:watch": "vitest",
    "e2e": "playwright test --project=demo --project=live-build",
    "screenshots": "playwright test --project=screenshots",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@paypal/paypal-js": "11.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/google-apps-script": "2.0.13",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "workbox-build": "7.4.1"
  }
}
