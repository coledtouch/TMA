{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["google-apps-script"]
  },
  "include": ["src/gas", "src/server", "src/shared"],
  "exclude": ["**/*.test.ts", "src/server/memory.ts", "src/server/test-helpers.ts"]
}
